<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);0649</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Mcp\Server\McpResourceLimits.cs" Link="McpResourceLimits.cs" />
    <Compile Include="..\..\src\Mcp\Server\McpRequestBodyReader.cs" Link="McpRequestBodyReader.cs" />
    <Compile Include="..\..\src\Mcp\Async\RevitExternalEventHandler.cs" Link="RevitExternalEventHandler.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\lib\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
